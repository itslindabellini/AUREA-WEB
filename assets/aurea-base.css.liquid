@font-face{font-family:'Milanesa Serif';src:url({{ 'MilanesaSerif-Regular.woff2' | asset_url }}) format('woff2'), url({{ 'MilanesaSerif-Regular.otf' | asset_url }}) format('opentype');font-weight:400;font-style:normal;font-display:swap;}
  @font-face{font-family:'Milanesa Serif';src:url({{ 'MilanesaSerif-DemiBold.woff2' | asset_url }}) format('woff2'), url({{ 'MilanesaSerif-DemiBold.otf' | asset_url }}) format('opentype');font-weight:600;font-style:normal;font-display:swap;}
  *{box-sizing:border-box;}
  html,body{margin:0;background:#ffffff;}
  a{color:#111111;text-decoration:none;}
  a:hover{color:#4A4A4A;}
  input::placeholder{color:#A79E92;}
  ::selection{background:#F5F0EB;color:#111;}
  @keyframes pulseDot{0%{box-shadow:0 0 0 0 rgba(178,58,46,.6);}70%{box-shadow:0 0 0 8px rgba(178,58,46,0);}100%{box-shadow:0 0 0 0 rgba(178,58,46,0);}}
  @keyframes marqueeLeft{from{transform:translateX(0);}to{transform:translateX(-50%);}}
  @keyframes marqueeRight{from{transform:translateX(-50%);}to{transform:translateX(0);}}
  @keyframes faqReveal{from{opacity:0;transform:translateY(-6px);}to{opacity:1;transform:translateY(0);}}

