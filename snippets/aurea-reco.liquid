{%- assign rec_col = collections.all -%}{%- for c in product.collections -%}{%- unless c.handle == 'frontpage' -%}{%- assign rec_col = c -%}{%- break -%}{%- endunless -%}{%- endfor -%}{%- assign rec_count = 0 -%}{%- for p in rec_col.products -%}{%- unless p.id == product.id -%}{%- assign rec_count = rec_count | plus: 1 -%}{%- endunless -%}{%- endfor -%}{%- if rec_count > 0 -%}<section style="max-width: 1320px; margin: 0px auto; padding: 64px 40px;"><div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 36px;"><div><div style="font-family: Manrope; font-weight: 700; font-size: 12.5px; letter-spacing: 0.3em; text-transform: uppercase; color: #8A7F70; margin-bottom: 14px;">You may also like</div><h2 style="font-family: &quot;Milanesa Serif&quot;, Georgia, serif; font-weight: 500; font-size: clamp(26px, 3vw, 38px); margin: 0px; color: #111;">{{ rec_col.title | default: 'More to Love' }}</h2></div><a href="{{ rec_col.url | default: '/collections/all' }}" class="scp0" style="font-family: Manrope; font-weight: 600; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #4A4A4A; text-decoration: none; border-bottom: 1px solid #DCD3C6; padding-bottom: 3px; white-space: nowrap;">View all</a></div><div class="pdp-reco">{%- assign rn = 0 -%}{%- for p in rec_col.products -%}{%- unless p.id == product.id -%}{%- if rn < 12 -%}<a class="pdp-reco-card" href="{{ p.url }}" style="cursor: pointer; text-decoration: none; color: inherit; display: block;"><div style="position: relative; aspect-ratio: 3 / 4; overflow: hidden; background: #F5F0EB;">{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 700 }}" alt="{{ p.title | escape }}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .5s;">{%- if p.images[1] -%}<img class="aurea-alt-img" src="{{ p.images[1] | image_url: width: 700 }}" alt="" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .5s;">{%- endif -%}{%- endif -%}{%- if p.tags contains 'bestseller' -%}<span style="position: absolute; top: 14px; left: 14px; background: #fff; color: #111; font-family: Manrope; font-size:11px; letter-spacing: 0.18em; text-transform: uppercase; padding: 6px 10px; z-index: 2;">Bestseller</span>{%- elsif p.tags contains 'new' -%}<span style="position: absolute; top: 14px; left: 14px; background: #fff; color: #111; font-family: Manrope; font-size:11px; letter-spacing: 0.18em; text-transform: uppercase; padding: 6px 10px; z-index: 2;">New</span>{%- endif -%}<div class="scp5" style="position: absolute; left: 0px; right: 0px; bottom: 0px; opacity: 0; transform: translateY(10px); transition: opacity 0.45s ease, transform 0.45s ease; z-index: 2; padding: 48px 14px 14px; background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.32) 48%, rgba(0, 0, 0, 0) 100%);"><button type="button" data-aurea-add="{{ p.selected_or_first_available_variant.id | default: p.variants.first.id }}" style="width: 100%; background: rgba(255, 255, 255, 0.1); color: rgb(255, 255, 255); border: 1px solid rgba(255, 255, 255, 0.85); padding: 13px; font-family: Manrope; font-weight: 600; font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; cursor: pointer; transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;">Quick Add</button></div></div><div style="padding-top: 16px; text-align: center;"><div style="font-family: Manrope; font-weight: 500; font-size: 15px; letter-spacing: 0.04em; color: #111;">{{ p.title }}</div><div style="display: flex; align-items: center; justify-content: center; gap: 9px; margin-top: 5px; font-family: Manrope; font-size: 13px;">{%- if p.compare_at_price > p.price -%}<span style="color: #B0A99E; text-decoration: line-through;">{{ p.compare_at_price | money }}</span><span style="color: #B23A2E; font-weight: 600;">{{ p.price | money }}</span>{%- else -%}<span style="color: #111; font-weight: 600;">{{ p.price | money }}</span>{%- endif -%}</div></div></a>{%- assign rn = rn | plus: 1 -%}{%- endif -%}{%- endunless -%}{%- endfor -%}</div></section>{%- endif -%}