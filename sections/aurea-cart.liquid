<div style="min-height:72vh;font-family:Manrope,-apple-system,sans-serif;color:#111;background:#fff;">
  <div style="text-align:center;padding:28px 24px 20px;border-bottom:1px solid #EFEAE2;">
    <a href="/" style="display:inline-block;"><img src="{{ 'aurea-logo.png' | asset_url }}" alt="AUREA Mykonos" style="height:48px;width:auto;display:block;"></a>
  </div>
  <div style="max-width:1040px;margin:0 auto;padding:44px 24px 90px;">
    <h1 style="font-family:'Milanesa Serif',Georgia,serif;font-weight:500;font-size:clamp(30px,4vw,42px);margin:0 0 28px;color:#111;">Your Bag</h1>

    {%- if cart.item_count == 0 -%}
      <div style="text-align:center;padding:70px 20px;">
        <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="#C9BFB1" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:22px;"><path d="M2 3h2.3l1.4 12.1a1 1 0 0 0 1 .9h9.1a1 1 0 0 0 1-.8l1.5-7.4H5.2"></path><circle cx="9" cy="20.2" r="1.35"></circle><circle cx="16.6" cy="20.2" r="1.35"></circle></svg>
        <div style="font-family:'Milanesa Serif',Georgia,serif;font-weight:500;font-size:22px;margin-bottom:10px;">Your bag is empty</div>
        <div style="font-size:14px;color:#9A948C;margin-bottom:28px;">Looks like you haven't added anything yet.</div>
        <a href="/collections/all" style="display:inline-block;background:#111;color:#fff;padding:15px 40px;font-weight:600;font-size:12px;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;">Continue Shopping</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post">
        <div style="border-top:1px solid #EFEAE2;">
          {%- for item in cart.items -%}
          <div style="display:flex;gap:20px;padding:24px 0;border-bottom:1px solid #F2EDE5;align-items:flex-start;">
            <a href="{{ item.url }}" style="width:92px;height:118px;flex:0 0 auto;background:#F5F0EB;overflow:hidden;display:block;">
              {%- if item.image -%}<img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.product.title | escape }}" style="width:100%;height:100%;object-fit:cover;">{%- endif -%}
            </a>
            <div style="flex:1 1 auto;min-width:0;">
              <a href="{{ item.url }}" style="font-family:'Milanesa Serif',Georgia,serif;font-weight:500;font-size:18px;color:#111;text-decoration:none;">{{ item.product.title }}</a>
              {%- unless item.variant.title contains 'Default' -%}<div style="font-size:12.5px;color:#9A948C;margin-top:5px;letter-spacing:.02em;">{{ item.variant.title }}</div>{%- endunless -%}
              <div style="margin-top:8px;font-size:14px;">
                {%- if item.original_price > item.final_price -%}
                  <span style="color:#B0A99E;text-decoration:line-through;">{{ item.original_price | money }}</span>
                  <span style="color:#B23A2E;font-weight:600;margin-left:6px;">{{ item.final_price | money }}</span>
                {%- else -%}
                  <span style="font-weight:600;">{{ item.final_price | money }}</span>
                {%- endif -%}
              </div>
              <div style="display:flex;align-items:center;gap:18px;margin-top:14px;flex-wrap:wrap;">
                <div style="display:inline-flex;align-items:center;border:1px solid #E4DBCE;">
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" aria-label="Decrease" style="width:34px;height:34px;display:flex;align-items:center;justify-content:center;color:#4A4A4A;text-decoration:none;font-size:16px;">–</a>
                  <span style="min-width:30px;text-align:center;font-weight:600;font-size:13px;">{{ item.quantity }}</span>
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" aria-label="Increase" style="width:34px;height:34px;display:flex;align-items:center;justify-content:center;color:#4A4A4A;text-decoration:none;font-size:16px;">+</a>
                </div>
                <a href="{{ item.url_to_remove }}" style="font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:#9A948C;text-decoration:underline;text-underline-offset:3px;">Remove</a>
              </div>
            </div>
            <div style="flex:0 0 auto;text-align:right;font-weight:600;font-size:14px;min-width:80px;">{{ item.final_line_price | money }}</div>
          </div>
          {%- endfor -%}
        </div>

        <div style="display:flex;justify-content:flex-end;margin-top:34px;">
          <div style="width:100%;max-width:380px;">
            <div style="display:flex;justify-content:space-between;font-size:15px;padding-bottom:16px;border-bottom:1px solid #EFEAE2;">
              <span style="color:#4A4A4A;">Subtotal</span>
              <span style="font-family:'Milanesa Serif',Georgia,serif;font-size:22px;">{{ cart.total_price | money }}</span>
            </div>
            <div style="font-size:12px;color:#9A948C;margin:12px 0 20px;">Shipping &amp; taxes calculated at checkout.</div>
            <button type="submit" name="checkout" style="width:100%;background:#111;color:#fff;border:1px solid #111;padding:18px;font-weight:700;font-size:12.5px;letter-spacing:.22em;text-transform:uppercase;cursor:pointer;">Checkout</button>
            <a href="/collections/all" style="display:block;text-align:center;margin-top:16px;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#4A4A4A;text-decoration:none;">Continue Shopping</a>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</div>
{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
